<!doctype html><html><head><title>Profile</title><link rel="stylesheet" href="/css/style.css"></head><body><nav class="nav"><b>CampusHire</b><div><a href="/student">Dashboard</a><a href="/notifications">Notifications</a></div></nav><div class="container"><h1>My Profile</h1><form class="card form" method="post"><input name="phone" placeholder="Phone" value="<%=s.phone||''%>"><input name="graduation_year" type="number" placeholder="Graduation Year" value="<%=s.graduation_year||''%>"><input name="tenth" type="number" step="0.01" placeholder="10th %" value="<%=s.tenth_percentage||''%>"><input name="twelfth" type="number" step="0.01" placeholder="12th %" value="<%=s.twelfth_percentage||''%>"><input name="cgpa" type="number" step="0.01" placeholder="CGPA" value="<%=s.cgpa||''%>"><input name="backlogs" type="number" placeholder="Backlogs" value="<%=s.backlogs||0%>"><button class="btn">Save Profile</button></form><div class="card"><h2>Skills</h2><p>Select the skills you currently have. Missing company-required skills will be shown, but <b>skills are not mandatory for applying</b>.</p><form method="post" action="/student/skills"><%allskills.forEach(sk=>{let has=skills.some(x=>x.skill_id===sk.skill_id);%><label style="display:block;margin:8px 0"><input type="checkbox" name="skills" value="<%=sk.skill_id%>" <%=has?'checked':''%>> <%=sk.skill_name%></label><%})%><button class="btn">Update Skills</button></form></div><div class="card"><h2>Resume URL</h2><form method="post" action="/student/resume"><input name="url" placeholder="https://..." required><button class="btn">Save Resume</button></form><%resumes.forEach(r=>{%><p><a href="<%=r.file_path%>" target="_blank">Resume v<%=r.version%></a></p><%})%></div></div></body></html>
