<!doctype html><html><head><title>Notifications</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="container"><h1>Notifications</h1><%ns.forEach(n=>{%><div class="card"><h3><%=n.title%></h3><p><%=n.message%></p><%if(!n.is_read){%><form method="post" action="/notifications/<%=n.notification_id%>"><button class="btn">Mark Read</button></form><%}%></div><%})%><a class="btn gray" href="/student">Dashboard</a></div></body></html>
