<!doctype html><html><head><title>Apply</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="container"><div class="card"><h1><%=d.drive_name%></h1><h3><%=d.company_name%> — <%=d.role_name%></h3><p>Package: ₹<%=d.package_lpa%> LPA | Location: <%=d.location%></p><p>Eligibility: CGPA <%=d.min_cgpa%>, 10th <%=d.min_tenth_percentage%>%, 12th <%=d.min_twelfth_percentage%>%, max backlogs <%=d.max_backlogs%></p><p>Required skills: <%skills.forEach(s=>{%><span class="badge"><%=s.skill_name%></span> <%})%></p><%if(missing.length){%><p class="danger"><b>Missing skills:</b> <%=missing.map(x=>x.skill_name).join(", ")%></p><p>These skills are shown for information only and are <b>not required to apply</b>.</p><%}else{%><p class="success">You have all the listed skills.</p><%}%><h2 class="<%=el[0]?'success':'danger'%>"><%=el[1]%></h2><%if(el[0]){%><form method="post"><button class="btn green">Apply Now</button></form><%}%><a class="btn gray" href="/drives">Back</a></div></div></body></html>
