<!doctype html><html><head><title>AI Career Assistant</title><link rel="stylesheet" href="/css/style.css"></head><body><nav class="nav"><b>CampusHire</b><div><a href="/student">Dashboard</a><a href="/student/profile">Profile</a><a href="/drives">Drives</a><a href="/applications">Applications</a><a href="/notifications">Notifications</a><a href="/logout">Logout</a></div></nav><div class="container"><div class="ai-hero"><div><span class="ai-pill">🤖 CAMPUSHIRE AI</span><h1>AI Career Assistant</h1><p>Get placement-focused resume feedback and instant student guidance in one place.</p></div></div><div class="grid ai-grid"><div class="card"><h2>📄 Resume Analyzer</h2><p class="small">ATS-style score, missing keywords, required improvements and course suggestions. No course links are shown.</p><form method="post" action="/student/ai/analyze" class="form ai-form"><label>Target role</label><select name="target_role"><option>Software Developer</option><option>Frontend Developer</option><option>Backend Developer</option><option>Data Analyst</option><option>Data Scientist</option></select><label>Paste your resume text</label><textarea name="resume_text" rows="14" placeholder="Paste your resume text here..." required><%=resumeText||''%></textarea><input type="hidden" name="resume_url" value="<%=resumeUrl||''%>"><button class="btn">Analyze Resume</button></form></div><div class="card"><h2>💬 Student Chatbot</h2><p class="small">Ask about placements, applications, interviews, skills, resumes or notifications.</p><div class="chat-box"><% if(chatAnswer){ %><div class="chat-user"><b>You:</b> <%=chatQuestion%></div><div class="chat-ai"><b>CampusHire AI:</b> <%=chatAnswer%></div><% } else { %><div class="chat-ai"><b>CampusHire AI:</b> Hi! Ask me anything about your CampusHire placement journey.</div><% } %></div><form method="post" action="/student/ai/chat" class="form"><input name="message" placeholder="e.g. How can I improve my resume?" required><button class="btn">Ask AI</button></form><div class="suggestions"><span>Resume help</span><span>How to prepare for interview?</span><span>How do I apply?</span></div></div></div><% if(result){ %><div class="card"><h2>ATS Analysis</h2><div class="ats-score"><div class="stat"><%=result.score%>/100</div><div>ATS-style readiness score for <b><%=result.targetRole%></b></div></div><div class="grid"><div><h3>✅ Detected keywords</h3><p><%=result.found.length?result.found.join(', '):'No target keywords detected yet.'%></p></div><div><h3>⚠️ Missing useful keywords</h3><p><%=result.missing.length?result.missing.join(', '):'No major target keywords are missing.'%></p></div></div><h3>Required improvements</h3><ul><%result.suggestions.forEach(x=>{ %><li><%=x%></li><%})%></ul><h3>Suggested courses</h3><p class="small">These are learning areas to strengthen; no external links are provided.</p><ul><%result.courses.forEach(x=>{ %><li><%=x%></li><%})%></ul><% if(result.missingSections.length){ %><h3>Sections to strengthen</h3><p><%=result.missingSections.join(', ')%></p><% } %></div><% } %></div></body></html>