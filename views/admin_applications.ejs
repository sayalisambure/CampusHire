<!doctype html><html><head><title>Applications</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="container"><h1>Application Management</h1><table class="table"><tr><th>Student</th><th>Company</th><th>Drive</th><th>Status</th><th>Update</th></tr><%rows.forEach(r=>{%><tr><td><%=r.student_name%></td><td><%=r.company_name%></td><td><%=r.drive_name%></td><td><%=r.status%></td><td><form method="post" action="/admin/application/<%=r.application_id%>"><select name="status"><option>APPLIED</option><option>APTITUDE</option><option>TECHNICAL</option><option>HR</option><option>SELECTED</option><option>REJECTED</option></select><input name="reason" placeholder="Rejection reason"><button class="btn">Save</button></form></td></tr><%})%></table></div></body></html>
