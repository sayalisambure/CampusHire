<!doctype html><html><head><title>Register</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="container"><form class="card form" method="post"><h2>Student Registration</h2><input name="x" placeholder="Full Name" required><input name="email" type="email" placeholder="Email" required><input name="password" type="password" placeholder="Password" required><select name="department_id" required><option value="">Department</option><%departments.forEach(d=>{%><option value="<%=d.department_id%>"><%=d.department_name%></option><%})%></select><button class="btn">Register</button><a href="/company-register" class="btn gray">Company Registration</a><a href="/login" class="btn gray">Login</a></form></div></body></html>
