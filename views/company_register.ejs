<!doctype html><html><head><title>Company Registration</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="container"><form class="card form" method="post"><h2>Company Registration</h2><%if(error){%><p class="danger"><%=error%></p><%}%><input name="company_name" placeholder="Company Name" required><input name="email" type="email" placeholder="Company Email" required><input name="password" type="password" placeholder="Password" required><input name="industry" placeholder="Industry"><input name="website" placeholder="Website"><input name="location" placeholder="Location"><button class="btn">Register Company</button><a href="/login" class="btn gray">Login</a></form></div></body></html>
