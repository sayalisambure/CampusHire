<!doctype html><html><head><title>Create Drive</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="container"><form class="card form" method="post"><h1>Create Placement Drive</h1><input name="drive_name" placeholder="Drive Name" required><input name="role_name" placeholder="Job Role" required><input name="package_lpa" type="number" step="0.01" placeholder="Package LPA" required><input name="location" placeholder="Location"><input name="drive_date" type="date"><input name="deadline" type="date"><input name="min_cgpa" type="number" step="0.01" placeholder="Minimum CGPA"><input name="min10" type="number" placeholder="Minimum 10th %"><input name="min12" type="number" placeholder="Minimum 12th %"><input name="max_backlogs" type="number" placeholder="Maximum Backlogs"><textarea name="description" placeholder="Description"></textarea><h3>Departments</h3><%deps.forEach(d=>{%><label><input type="checkbox" name="deps" value="<%=d.department_id%>"> <%=d.department_name%></label><br><%})%><h3>Skills</h3><%skills.forEach(s=>{%><label><input type="checkbox" name="skills" value="<%=s.skill_id%>"> <%=s.skill_name%></label><br><%})%><button class="btn">Create</button></form></div></body></html>
