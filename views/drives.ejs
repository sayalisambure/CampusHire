<!doctype html><html><head><title>Drives</title><link rel="stylesheet" href="/css/style.css"></head><body><nav class="nav"><b>CampusHire</b><a href="/student">Dashboard</a></nav><div class="container"><h1>Placement Drives</h1><div class="grid"><%ds.forEach(d=>{%><div class="card"><h2><%=d.drive_name%></h2><p><b><%=d.company_name%></b> — <%=d.role_name%></p><p>₹<%=d.package_lpa%> LPA | <%=d.location%></p><p>Deadline: <%=d.application_deadline%></p><p class="<%=d.el[0]?'success':'danger'%>"><%=d.el[1]%></p><%if(d.applied){%><span class="badge">Already Applied</span><%}else if(d.el[0]){%><a class="btn" href="/apply/<%=d.drive_id%>">View & Apply</a><%}%></div><%})%></div></div></body></html>
