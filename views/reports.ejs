<!doctype html><html><head><title>Reports</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="container"><h1>Reports</h1><div class="grid"><div class="card">Students<h2><%=st.students%></h2></div><div class="card">Applications<h2><%=st.applications%></h2></div><div class="card">Placements<h2><%=st.placements%></h2></div><div class="card">Placement %<h2><%=st.percentage%>%</h2></div><div class="card">Average Package<h2>₹<%=st.avg_package||0%> LPA</h2></div><div class="card">Highest Package<h2>₹<%=st.max_package||0%> LPA</h2></div></div><h2>Applications by Company</h2><table class="table"><tr><th>Company</th><th>Applications</th></tr><%by.forEach(x=>{%><tr><td><%=x.company_name%></td><td><%=x.count%></td></tr><%})%></table></div></body></html>
